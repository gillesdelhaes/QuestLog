# Copy this to .env and fill in values

# REQUIRED: Generate a strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY=changeme-please-generate-a-real-secret

# Optional — default is /data/questlog.db inside the container
# DB_PATH=/data/questlog.db

# Optional — port exposed on host (default 8420)
# PORT=8420

# Optional — token lifetime in minutes (default 7 days)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
